    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.60.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
