  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
