{
  "name": "monorepo-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.18.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "start": "turbo run start --filter=@repo/web",
    "storage:up": "docker compose up --detach --wait --remove-orphans rustfs && docker compose run --rm rustfs-init",
    "storage:down": "docker compose down --remove-orphans",
    "storage:logs": "docker compose logs --follow rustfs",
    "storage:status": "docker compose exec -T rustfs curl -fsS http://127.0.0.1:9000/health",
    "storage:reset": "docker compose down --volumes --remove-orphans",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:ui": "turbo run test:e2e:ui --filter=@repo/web",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  }
}
